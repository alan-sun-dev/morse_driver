# PROPOSED, UNTESTED. See README.md in this directory before using it.
#
# Would be installed as /usr/src/morse-<PACKAGE_VERSION>/dkms.conf, with the
# submodule already populated in that tree -- DKMS does not resolve git
# submodules, and the build fails on a missing mmrc.h if it is empty.

PACKAGE_NAME="morse"
PACKAGE_VERSION="2.0.1-rpi-portability"

MAKE[0]="make -C ${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build \
    KERNEL_SRC=${kernel_source_dir} \
    CONFIG_WLAN_VENDOR_MORSE=m \
    CONFIG_MORSE_SPI=y \
    CONFIG_MORSE_USER_ACCESS=y \
    CONFIG_MORSE_VENDOR_COMMAND=y \
    CONFIG_MORSE_DEBUGFS=y"

CLEAN="make -C ${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build \
    KERNEL_SRC=${kernel_source_dir} clean"

BUILT_MODULE_NAME[0]="morse"
BUILT_MODULE_LOCATION[0]=""
DEST_MODULE_LOCATION[0]="/updates"

BUILT_MODULE_NAME[1]="dot11ah"
BUILT_MODULE_LOCATION[1]="dot11ah"
DEST_MODULE_LOCATION[1]="/updates"

# Deliberately "no": ccflags-y carries -Werror, so a warning introduced by a
# newer kernel's headers becomes a build failure during an unattended kernel
# upgrade, and the driver disappears at the next boot with no warning to the
# user. Rebuild explicitly after a kernel change:
#     sudo dkms install morse/2.0.1-rpi-portability -k $(uname -r)
AUTOINSTALL="no"
