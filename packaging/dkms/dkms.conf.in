# Template. prepare-source.sh substitutes @VERSION@ and writes dkms.conf into
# the staged source tree. Do not hand-edit the generated copy.
#
# Upstream's Makefile is used unchanged: it already builds out-of-tree with
# -C $(KERNEL_SRC) M=$(SRC) and takes every option from the command line.

PACKAGE_NAME="morse"
PACKAGE_VERSION="@VERSION@"

MAKE[0]="make -C ${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build \
    KERNEL_SRC=${kernel_source_dir} \
    CONFIG_WLAN_VENDOR_MORSE=m \
    CONFIG_MORSE_SPI=y \
    CONFIG_MORSE_USER_ACCESS=y \
    CONFIG_MORSE_VENDOR_COMMAND=y \
    CONFIG_MORSE_DEBUGFS=y"

CLEAN="make -C ${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build \
    KERNEL_SRC=${kernel_source_dir} clean"

# morse uses symbols exported by dot11ah, so both must be installed.
BUILT_MODULE_NAME[0]="morse"
BUILT_MODULE_LOCATION[0]=""
DEST_MODULE_LOCATION[0]="/updates"

BUILT_MODULE_NAME[1]="dot11ah"
BUILT_MODULE_LOCATION[1]="dot11ah"
DEST_MODULE_LOCATION[1]="/updates"

# Intended, and validated on hardware: on 2026-08-25 a kernel upgrade from
# 6.6.51 to 6.12.96 rebuilt and installed this module unattended, for both the
# -v8 and -2712 flavours, and the radio associated on the first attempt after
# the reboot.
#
# Note for anyone editing this: with dkms 3.0.10 the OFF value is not "no".
# dkms tests `[[ ! $AUTOINSTALL ]]`, which is a test for empty, so every
# non-empty string -- "no" included -- enables autoinstall. To disable it the
# variable must be absent or empty, and then every kernel change needs
#     sudo dkms install morse/@VERSION@ -k <kernelrelease>
#
# The residual risk is a build that fails on a future kernel: ccflags-y carries
# -Werror (unchanged from upstream, deliberately), so a new warning becomes a
# build failure and autoinstall then leaves the system with no driver at the
# next boot. Verify a kernel upgrade before rebooting into it -- the checklist
# is in the lifecycle protocol linked from README.md.
AUTOINSTALL="yes"
